# Database and queues
DATABASE_URL=postgres://localhost:5432/shipyard
REDIS_URL=redis://localhost:6379/0

# Control API and dashboard
# PORT defaults to 4010 for the Control API and 4012 for the Deploy Engine.
CONTROL_API_URL=http://localhost:4010
DEPLOY_ENGINE_URL=http://localhost:4012
CLIENT_URL=http://localhost:4013
DASHBOARD_ORIGIN=http://localhost:4013
NEXT_PUBLIC_API_URL=http://localhost:4010
NEXT_PUBLIC_SITE_URL=http://localhost:4013
BETTER_AUTH_URL=http://localhost:4010
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Required to encrypt project environment variables; use exactly 32 characters.
ENCRYPTION_KEY=00000000000000000000000000000000

# Uptime email alerts (optional; alerts are queued until configured)
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL="ShipYard Uptime <uptime@example.com>"

# GitHub OAuth and App integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=
GITHUB_INSTALL_URL=

# Domains, DNS, and TLS (needed for automatic domains in production)
BASE_DOMAIN=thakur.dev
SERVER_HOST=127.0.0.1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CERTBOT_EMAIL=admin@example.com
CERTBOT_WEBROOT=/var/www/certbot
NGINX_SITES_DIR=/etc/nginx/platform-sites

# Deploy engine
PLATFORM_ENV=development
USE_DOCKER=false
BASE_DIR=./apps
PORT_RANGE_START=5000
PORT_RANGE_END=6000
