# ShipYard reads this one file (at the repository root) in every service.
# scripts/install.sh writes it for you; for development, copy it to .env.

# Where the dashboard is served. Apps go under its parent domain
# (deploy.example.com -> <app>.example.com); development uses <app>.localhost.
PUBLIC_URL=http://localhost:4013

# One long random string (e.g. `openssl rand -hex 32`). Sign-in, encryption and internal
# keys are derived from it, so keep it stable once projects store env vars.
SECRET=replace-with-a-long-random-secret

DATABASE_URL=postgres://localhost:5432/shipyard
REDIS_URL=redis://127.0.0.1:6379/0

# GitHub, Cloudflare and uptime emails are set in the dashboard: first-run setup at
# /setup creates the GitHub App, and Settings holds the rest (stored encrypted).

# --- Optional overrides (all have working defaults) ---------------------------------------
# NODE_ENV=production            # production: Nginx, HTTPS and real domains for apps
# BASE_DOMAIN=apps.example.com   # instead of the dashboard's parent domain
# SERVER_HOST=203.0.113.10       # public IP for DNS records; detected when unset
# CERTBOT_EMAIL=you@example.com  # only matters if certbot has no account yet
# BASE_DIR=/var/lib/shipyard/apps  # where deployed apps are built (keep it outside this repo)
# USE_DOCKER=false
# PORT_RANGE_START=5000
# PORT_RANGE_END=6000
# CONTROL_API_URL=http://127.0.0.1:4010
# DEPLOY_ENGINE_URL=http://127.0.0.1:4012
#
# Older installs: GITHUB_*, CLOUDFLARE_*, RESEND_*, BETTER_AUTH_SECRET, ENCRYPTION_KEY,
# CLIENT_URL and per-package .env files are still read. Values saved in Settings win.
