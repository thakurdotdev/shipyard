# Non-docker (pm0) deployments: keep this "false". Set "true" to use Docker.
USE_DOCKER="false"
PORT=4012
CONTROL_API_URL=http://localhost:4010
REDIS_URL=redis://localhost:6379/0
DASHBOARD_ORIGIN=http://localhost:4013

# GitHub App (used to clone repositories during builds).
# GITHUB_APP_ID must match control-api's App (and the App that owns the PEM),
# otherwise installation tokens fail with HTTP 401.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
