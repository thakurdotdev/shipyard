DATABASE_URL=postgres://localhost:5432/shipyard
REDIS_URL=redis://localhost:6379/0
DEPLOY_ENGINE_URL=http://localhost:4012

PORT=4010

CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

BETTER_AUTH_URL=http://localhost:4010
BETTER_AUTH_SECRET=""
CLIENT_URL=http://localhost:4013

# Security
# Used by: Control API (for encrypting user env vars)
# Must be 32 characters long
ENCRYPTION_KEY=""


GITHUB_APP_ID=
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""
# Path to the GitHub App private key (.pem). Resolved from the process working
# directory (the package folder). When unset it falls back to the repo root.
GITHUB_APP_PRIVATE_KEY_PATH=

# Optional: GitHub App identity served at GET /github/app for the UI's
# "Connect GitHub App" buttons. When set, these win over auto-detection.
#   GITHUB_INSTALL_URL — full install URL, e.g. a separate dev/prod App
#   GITHUB_APP_SLUG     — slug for github.com, e.g. "my-dev-app"
# If both are empty, the server derives the slug/name from GitHub itself via
# GET /app (same JWT + key already used for installation tokens), cached 1h.
#GITHUB_INSTALL_URL=""
#GITHUB_APP_SLUG=""

SERVER_HOST=